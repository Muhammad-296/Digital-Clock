                                 ;------------------------------------------------------------------------------
                                 ; Date Functions
                                 ;------------------------------------------------------------------------------
                                 IS_LEAP_YEAR:
00069a 930f                          push r16
00069b 931f                          push r17
                                     
00069c 2f10                          mov r17, r16
00069d 7013                          andi r17, 0x03
00069e f011                          breq ILY_DIV_BY_4
00069f 2788                          clr r24
0006a0 c00b                          rjmp ILY_END
                                     
                                 ILY_DIV_BY_4:
0006a1 e614                          ldi r17, 100
0006a2 d065                          rcall DIV8
0006a3 3090                          cpi r25, 0
0006a4 f431                          brne ILY_LEAP
0006a5 3604                          cpi r16, 100
0006a6 f411                          brne ILY_NOT_LEAP
0006a7 e081                          ldi r24, 1
0006a8 c003                          rjmp ILY_END
                                     
                                 ILY_NOT_LEAP:
0006a9 2788                          clr r24
0006aa c001                          rjmp ILY_END
                                     
                                 ILY_LEAP:
0006ab e081                          ldi r24, 1
                                     
                                 ILY_END:
0006ac 911f                          pop r17
0006ad 910f                          pop r16
0006ae 9508                          ret
                                 
                                 DAYS_IN_MONTH:
0006af 930f                          push r16
0006b0 931f                          push r17
                                     
0006b1 3000                          cpi r16, 0
0006b2 f411                          brne DIM_CHECK_12
0006b3 e18f                          ldi r24, 31
0006b4 c016                          rjmp DIM_END
                                     
                                 DIM_CHECK_12:
0006b5 300d                          cpi r16, 13
0006b6 f010                          brlo DIM_VALID
0006b7 e18f                          ldi r24, 31
0006b8 c012                          rjmp DIM_END
                                     
                                 DIM_VALID:
0006b9 3002                          cpi r16, 2
0006ba f451                          brne DIM_NOT_FEB
                                     
0006bb 930f                          push r16
0006bc 2f01                          mov r16, r17
0006bd dfdc                          rcall IS_LEAP_YEAR
0006be 910f                          pop r16
                                     
0006bf 3080                          cpi r24, 0
0006c0 f011                          breq DIM_FEB_28
0006c1 e18d                          ldi r24, 29
0006c2 c008                          rjmp DIM_END
                                     
                                 DIM_FEB_28:
0006c3 e18c                          ldi r24, 28
0006c4 c006                          rjmp DIM_END
                                     
                                 DIM_NOT_FEB:
0006c5 e8ee                          ldi ZL, low(DAYS_TABLE<<1)
0006c6 e1f0                          ldi ZH, high(DAYS_TABLE<<1)
0006c7 950a                          dec r16
0006c8 0fe0                          add ZL, r16
0006c9 1df1                          adc ZH, r1
0006ca 9184                          lpm r24, Z
                                     
                                 DIM_END:
0006cb 911f                          pop r17
0006cc 910f                          pop r16
0006cd 9508                          ret
                                 
                                 ADVANCE_DATE:
0006ce 930f                          push r16
0006cf 931f                          push r17
0006d0 932f                          push r18
                                     
0006d1 9100 0065                     lds r16, day
0006d3 9503                          inc r16
                                     
0006d4 9110 0066                     lds r17, month
0006d6 9120 0067                     lds r18, year
0006d8 930f                          push r16
0006d9 2f01                          mov r16, r17
0006da 2f12                          mov r17, r18
0006db dfd3                          rcall DAYS_IN_MONTH
0006dc 910f                          pop r16
                                     
0006dd 1708                          cp r16, r24
0006de f0d0                          brlo AD_DAY_OK
0006df f0c9                          breq AD_DAY_OK
                                     
0006e0 e001                          ldi r16, 1
0006e1 9300 0065                     sts day, r16
                                     
0006e3 9110 0066                     lds r17, month
0006e5 9513                          inc r17
                                     
0006e6 301d                          cpi r17, 13
0006e7 f070                          brlo AD_MONTH_OK
                                     
0006e8 e011                          ldi r17, 1
0006e9 9310 0066                     sts month, r17
                                     
0006eb 9120 0067                     lds r18, year
0006ed 9130 0068                     lds r19, year+1
0006ef 5f2f                          subi r18, -1
0006f0 4f3f                          sbci r19, -1
0006f1 9320 0067                     sts year, r18
0006f3 9330 0068                     sts year+1, r19
0006f5 c005                          rjmp AD_END
                                     
                                 AD_MONTH_OK:
0006f6 9310 0066                     sts month, r17
0006f8 c002                          rjmp AD_END
                                     
                                 AD_DAY_OK:
0006f9 9300 0065                     sts day, r16
                                     
                                 AD_END:
0006fb 912f                          pop r18
0006fc 911f                          pop r17
0006fd 910f                          pop r16
0006fe 9508                          ret
                                 

000634 b302                          in r16, PORTD
000635 6308                          ori r16, (1<<LED_GREEN)|(1<<LED_RED)|(1<<LED_YELLOW)
000636 bb02                          out PORTD, r16
000637 9a96                          sbi PORTD, BUZZER
000638 e986                          ldi r24, 150
000639 dbbb                          rcall DELAY_MS
                                     

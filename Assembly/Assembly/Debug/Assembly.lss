                                 LCD_PCA_WRITE:
000126 918f                          pop r24
000127 dfcc                          rcall LCD_CHAR
000128 9508                          ret
                                 
                                 LCD_PRINT_FULL_LINE:
000129 936f                          push r22
00012a e6ef                          ldi ZL, low(line_buffer)
00012b e0f0                          ldi ZH, high(line_buffer)
                                     
00012c 2700                          clr r16
                                 LCD_PFL_COUNT:
00012d 9111                          ld r17, Z+
00012e 3010                          cpi r17, 0
00012f f019                          breq LCD_PFL_GOT_LEN
000130 9503                          inc r16
000131 3101                          cpi r16, 17
000132 f3d0                          brlo LCD_PFL_COUNT
                                     
                                 LCD_PFL_GOT_LEN:
000133 3100                          cpi r16, 16
000134 f008                          brlo LCD_PFL_OK
000135 e100                          ldi r16, 16
                                 LCD_PFL_OK:
                                     
000136 e110                          ldi r17, 16
000137 1b10                          sub r17, r16
000138 9516                          lsr r17
000139 2f21                          mov r18, r17
                                     
00013a e6ef                          ldi ZL, low(line_buffer)
00013b e0f0                          ldi ZH, high(line_buffer)
00013c e7af                          ldi XL, low(line_buffer+16)
00013d e0b0                          ldi XH, high(line_buffer+16)
                                     
00013e 2f32                          mov r19, r18
                                 LCD_PFL_PAD1:
00013f 3030                          cpi r19, 0
000140 f021                          breq LCD_PFL_COPY
000141 e280                          ldi r24, ' '
000142 938e                          st -X, r24
000143 953a                          dec r19
000144 cffa                          rjmp LCD_PFL_PAD1
                                     
                                 LCD_PFL_COPY:
000145 2f30                          mov r19, r16
                                 LCD_PFL_COPY_LOOP:
000146 3030                          cpi r19, 0
000147 f021                          breq LCD_PFL_PAD2
000148 9181                          ld r24, Z+
000149 938e                          st -X, r24
00014a 953a                          dec r19
00014b cffa                          rjmp LCD_PFL_COPY_LOOP
                                     
                                 LCD_PFL_PAD2:
00014c e130                          ldi r19, 16
00014d 1b30                          sub r19, r16
00014e 1b32                          sub r19, r18
                                 LCD_PFL_PAD2_LOOP:
00014f 3030                          cpi r19, 0
000150 f021                          breq LCD_PFL_PRINT
000151 e280                          ldi r24, ' '
000152 938e                          st -X, r24
000153 953a                          dec r19
000154 cffa                          rjmp LCD_PFL_PAD2_LOOP
                                     
                                 LCD_PFL_PRINT:
000155 e6ef                          ldi ZL, low(line_buffer)
000156 e0f0                          ldi ZH, high(line_buffer)
000157 e100                          ldi r16, 16
                                 LCD_PFL_PRINT_LOOP:
000158 3000                          cpi r16, 0
000159 f029                          breq LCD_PFL_NULL
00015a 9181                          ld r24, Z+
00015b 8380                          st Z, r24
00015c 95e3                          inc ZL
00015d 950a                          dec r16
00015e cff9                          rjmp LCD_PFL_PRINT_LOOP
                                     
                                 LCD_PFL_NULL:
00015f 2788                          clr r24
000160 8380                          st Z, r24
                                     
000161 e6ef                          ldi ZL, low(line_buffer)
000162 e0f0                          ldi ZH, high(line_buffer)
000163 916f                          pop r22
000164 e070                          ldi r23, 0
000165 dfa4                          rcall LCD_STRING_XY_SRAM
000166 9508                          ret
                                 

000195 7f00                          andi r16, ~KEYPAD_ROWS_MASK
000196 6007                          ori r16, 0x07
000197 bb05                          out PORTC, r16
000198 e083                          ldi r24, 3
000199 d05b                          rcall DELAY_MS

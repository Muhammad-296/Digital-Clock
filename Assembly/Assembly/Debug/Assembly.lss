000202 e503                          ldi r16, 83         ; More precise: (250-3)/3 = ~82.3
                                 DELAY_US_250_LOOP:
000203 0000                          nop
000204 950a                          dec r16
000205 f7e9                          brne DELAY_US_250_LOOP
000206 910f                          pop r16
000207 9508                          ret
                                 
                                 DELAY_US_40:

00019b ff14                          sbrs r17, 4
00019c c023                          rjmp KC_R4C1
00019d ff15                          sbrs r17, 5
00019e c023                          rjmp KC_R4C2
00019f ff16                          sbrs r17, 6
0001a0 c023                          rjmp KC_R4C3
0001a1 ff17                          sbrs r17, 7

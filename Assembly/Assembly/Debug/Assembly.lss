000735 e1f0                          ldi ZH, high(STR_MONTH_INVALID<<1)
000736 c007                          rjmp GMN_END
                                     
                                 GMN_OK:
000737 950a                          dec r16
000738 e013                          ldi r17, 3
000739 9f01                          mul r16, r17
00073a e6e8                          ldi ZL, low(MONTH_NAMES<<1)
00073b e1f0                          ldi ZH, high(MONTH_NAMES<<1)
00073c 0de0                          add ZL, r0
00073d 1df1                          adc ZH, r1
                                     
                                 GMN_END:
00073e 911f                          pop r17
00073f 910f                          pop r16
000740 9508                          ret
                                 
                                 COPY_PROGMEM_TO_BUFFER:

00061f ef8a                          ldi r24, 250
000620 dbd4                          rcall DELAY_MS
000621 e684                          ldi r24, 100
000622 dbd2                          rcall DELAY_MS
000623 9895                          cbi PORTD, LED_YELLOW
                                     
000624 dada                          rcall LCD_CLEAR
000625 9508                          ret
                                 

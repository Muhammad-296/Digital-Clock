00018c ff14                          sbrs r17, 4
00018d c02a                          rjmp KC_R3C1
00018e ff15                          sbrs r17, 5
00018f c02a                          rjmp KC_R3C2
000190 ff16                          sbrs r17, 6
000191 c02a                          rjmp KC_R3C3
000192 ff17                          sbrs r17, 7
000193 c02a                          rjmp KC_R3C4
                                     

                                 ;------------------------------------------------------------------------------
                                 ; Delay Functions - OPTIMIZED FOR 1MHz
                                 ;------------------------------------------------------------------------------
                                 DELAY_MS:
0001f5 938f                          push r24
0001f6 939f                          push r25
                                 DELAY_MS_OUTER:
0001f7 ef9a                          ldi r25, 250        ; More precise: 250 iterations
                                 DELAY_MS_INNER:
0001f8 0000                          nop
0001f9 0000                          nop
0001fa 959a                          dec r25
0001fb f7e1                          brne DELAY_MS_INNER
0001fc 958a                          dec r24
0001fd f7c9                          brne DELAY_MS_OUTER
0001fe 919f                          pop r25
0001ff 918f                          pop r24
000200 9508                          ret
                                 
                                 DELAY_US_250:

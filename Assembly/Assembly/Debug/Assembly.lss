000214 df14                          rcall LCD_PRINT_FULL_LINE
                                     
000215 eaea                          ldi ZL, low(STR_WITH_DATE<<1)
000216 e0fe                          ldi ZH, high(STR_WITH_DATE<<1)
000217 d529                          rcall COPY_PROGMEM_TO_BUFFER
000218 e061                          ldi r22, 1
000219 df0f                          rcall LCD_PRINT_FULL_LINE
                                     
00021a 9a95                          sbi PORTD, LED_YELLOW
00021b 9a93                          sbi PORTD, LED_GREEN
00021c ef8a                          ldi r24, 250
00021d dfd7                          rcall DELAY_MS
00021e dfd6                          rcall DELAY_MS
00021f dfd5                          rcall DELAY_MS
000220 dfd4                          rcall DELAY_MS
000221 ec88                          ldi r24, 200
000222 dfd2                          rcall DELAY_MS
                                     
000223 b302                          in r16, PORTD
000224 7c07                          andi r16, ~((1<<LED_GREEN)|(1<<LED_RED)|(1<<LED_YELLOW))
000225 bb02                          out PORTD, r16
000226 ded8                          rcall LCD_CLEAR
000227 9508                          ret
                                 

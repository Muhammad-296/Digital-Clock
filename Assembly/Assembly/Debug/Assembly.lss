                                 YEAR_TO_ASCII:
000712 930f                          push r16
000713 931f                          push r17
                                     
000714 e382                          ldi r24, '2'
000715 9381                          st Z+, r24
                                     
000716 2f01                          mov r16, r17
000717 e614                          ldi r17, 100
000718 dfef                          rcall DIV8
                                     
000719 2f28                          mov r18, r24
00071a e380                          ldi r24, '0'
00071b 0f82                          add r24, r18
00071c 9381                          st Z+, r24
                                     
00071d 2f09                          mov r16, r25
00071e e01a                          ldi r17, 10
00071f dfe8                          rcall DIV8
                                     
000720 2f28                          mov r18, r24
000721 e380                          ldi r24, '0'
000722 0f82                          add r24, r18
000723 9381                          st Z+, r24
                                     
000724 2f29                          mov r18, r25
000725 e380                          ldi r24, '0'
000726 0f82                          add r24, r18
000727 9381                          st Z+, r24
                                     
000728 911f                          pop r17
000729 910f                          pop r16
00072a 9508                          ret
                                 
                                 GET_MONTH_NAME:
00072b 930f                          push r16
00072c 931f                          push r17
                                     
00072d 3000                          cpi r16, 0
00072e f419                          brne GMN_VALID
00072f e6e4                          ldi ZL, low(STR_MONTH_INVALID<<1)
000730 e1f0                          ldi ZH, high(STR_MONTH_INVALID<<1)
